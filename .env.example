# ─── Copia este archivo como .env y completa los valores. .env NO se versiona. ───

# Entorno: development | test | staging | production
NODE_ENV=development
PORT=3000

# MongoDB Atlas — usar un cluster/base DISTINTO por entorno.
# Nunca usar la base de producción en desarrollo.
# El usuario de BD debe tener permisos mínimos (no admin del cluster).
MONGODB_URI=

# JWT — generar secretos largos y aleatorios, distintos entre sí y por entorno.
JWT_SECRET=
JWT_REFRESH_SECRET=
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=7d

# Almacenamiento de archivos (metadata en Mongo, binarios aquí)
STORAGE_PROVIDER=
STORAGE_BUCKET=
STORAGE_ACCESS_KEY=
STORAGE_SECRET_KEY=

# Email
EMAIL_PROVIDER=
EMAIL_API_KEY=

# Push notifications
PUSH_PROVIDER=
PUSH_API_KEY=

# Rate limiting
THROTTLE_TTL=60
THROTTLE_LIMIT=120

# CORS — orígenes permitidos separados por coma (web y móvil dev)
CORS_ORIGINS=http://localhost:3001
